# =============================================================================
# FORAGER: MONOREPO ENVIRONMENT VARIABLES
# Copy this file to .env at root or in respective app directories:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION PORTS & RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000
AGENT_WORKER_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVICE ROLE KEY (RESTRICTED: Used EXCLUSIVELY by apps/agent-worker; NEVER in apps/web)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# DIRECT POSTGRESQL / DRIZZLE ORM CONNECTION
# Found in: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# -----------------------------------------------------------------------------
# FIRECRAWL CONFIGURATION
# Found in: https://www.firecrawl.dev/app/api-keys
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=fc-your-api-key

# -----------------------------------------------------------------------------
# LLM PROVIDERS (Explore-Critic Traversal, Proposition Distillation & Critic)
# -----------------------------------------------------------------------------
# Default provider: openai, groq, or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
GROQ_API_KEY=gsk_your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional Model Overrides:
AI_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o
SCOUT_MODEL=gpt-4o-mini

# Optional Rate-Limit Pacing & Retries (e.g., set LLM_MAX_RPM=12 for Gemini Free Tier 15 RPM):
LLM_MAX_RPM=
LLM_MAX_RETRIES=3
